@page "/"
@using Microsoft.AspNetCore.Authorization
@using RSChatApp.Web.Components.Pages.Chat.UserConfirmation
@using RSChatApp.Web.Components.Pages.Terminal
@using RSChatApp.Web.Filter.UserConfirmation
@using RSChatApp.Web.Models.Chat.UserConfirmation

@attribute [AllowAnonymous]

<div class="chat-page @(_terminalVisible ? "terminal-visible" : "")" style="@(_terminalVisible ? $"--terminal-height: {_terminalHeight}px" : "")">
    <ChatHeader OnNewChat="@ResetConversationAsync" OnToggleTerminal="@ToggleTerminal" />
    
    <div class="chat-messages-area">
        <ChatMessageList Messages="@_messages" InProgressMessage="@_currentResponseMessage">
            <NoMessagesContent>
                <div>Welcome to the ReportServer Agent.</div>
                <ChatCitation Keyword="admin"/>
                <ChatCitation Keyword="config"/>
                <ChatCitation Keyword="user"/>
                <ChatCitation Keyword="script"/>
            </NoMessagesContent>
        </ChatMessageList>
    </div>

    <div class="chat-container">
        <div class="chat-suggestions">
            <ChatSuggestions OnSelected="@AddUserMessageAsync" @ref="@_chatSuggestions"/>
        </div>
        <div class="chat-input">
            <ChatInput OnSend="@AddUserMessageAsync" OnAbort="@CancelAnyCurrentResponse" @ref="@_chatInput"/>
        </div>
    </div>
    
    <TerminalManager @ref="_terminalManager" IsVisible="@_terminalVisible" Height="@_terminalHeight" OnHeightChanged="@((h) => { _terminalHeight = h; StateHasChanged(); })" />

    @if (_pendingToolCallRequest is not null)
    {
        <div class="confirm-overlay" role="presentation">
            <ChatUserConfirmedToolCall
                IsVisible="true"
                Title="Confirm terminal command"
                ToolName="@_pendingToolCallRequest.ToolName"
                Arguments="@_pendingToolCallRequest.Arguments"
                OnRun="@((confirmationToolCall) => ResolveTerminalConfirmationAsync(confirmationToolCall))"
                OnSkip="@(() => ResolveTerminalConfirmationAsync(UserConfirmationToolCall.Skipped))"
                OnCancel="@(() => ResolveTerminalConfirmationAsync(UserConfirmationToolCall.Cancelled))"
                ShowCancel="false"
                @ref="@_currentToolCallConfirmation"
                />
        </div>
    }
    @if (_pendingToolResultRequest is not null)
    {
        <div class="confirm-overlay" role="presentation">
            <ChatUserConfirmedToolResult
                IsVisible="true"
                Title="Confirm terminal command"
                ToolName="@_pendingToolResultRequest.ToolName"
                Subtitle="Please confirm or redact the input before proceeding."
                OnRun="@((toolResult) => ResolveToolResultConfirmationAsync(new UserConfirmationToolResult{ UserConfirmationResult = UserConfirmationResultEnum.Confirmed, ToolResult = toolResult}))"
                OnSkip="@(() => ResolveToolResultConfirmationAsync(UserConfirmationToolResult.Skipped))"
                @* OnRedact="@(() => RedactAsync())" *@
                @ref="@_currentToolResultConfirmation"
            />
        </div>
    }
</div>

