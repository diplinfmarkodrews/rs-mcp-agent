@using System.Text.Json
@using RSChatApp.Shared.Infrastructure.Mcp.SemanticSearch.Models
@using RSChatApp.Web.Models.Chat.ToolCalls

<div class="document-lookup-result">
    @if (!string.IsNullOrWhiteSpace(DocumentText))
    {
        <div class="document-text">
            <pre><code>@DocumentText</code></pre>
        </div>
    }

    @if (Images is { Count: > 0 })
    {
        <div class="document-images">
            <div class="document-images-header">
                <span>@Images.Count image(s)</span>
            </div>
            <div class="document-images-grid">
                @foreach (var imageSrc in Images)
                {
                    <div class="document-image-item">
                        <img src="@imageSrc" alt="Document page image" loading="lazy" />
                    </div>
                }
            </div>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(DocumentText) && (Images is null || Images.Count == 0) && string.IsNullOrWhiteSpace(ErrorMessage) == false)
    {
        <p class="document-empty">@ErrorMessage</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required ToolResult Result { get; set; }

    private string? DocumentText { get; set; }
    private List<string>? Images { get; set; }
    private string? ErrorMessage { get; set; }
    protected override void OnParametersSet()
    {
        DocumentText = null;
        Images = null;

        try
        {
            var rawText = Result.Data switch
            {
                string s => s,
                JsonElement e => e.GetRawText(),
                _ => Result.Data?.ToString()
            };
         
            if (string.IsNullOrWhiteSpace(rawText))
            {
                ErrorMessage = "No content available for this page.";
                return;
            }
            
            if (rawText.StartsWith("Error:", StringComparison.OrdinalIgnoreCase))
            {
                ErrorMessage = rawText;
                return;
            }
            
            var documentObject = JsonSerializer.Deserialize<DocumentLookupResult>(rawText, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
            });
            if (documentObject is null)
            {
                ErrorMessage = "Error deserialzing document content.";
                return;
            }
            DocumentText = documentObject.Text;
            if (documentObject.Images is null)
                return;
            
            Images = documentObject.Images
                .Select(d => d.ImageData.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? d.ImageData : $"data:image/png;base64,{d.ImageData}")
                .ToList();
          
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

}
