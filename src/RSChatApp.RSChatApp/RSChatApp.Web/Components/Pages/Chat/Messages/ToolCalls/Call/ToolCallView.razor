@using RSChatApp.Web.Models.Chat.ToolCalls
@using RSChatApp.Web.Services.Chat.Tools

@inject ToolRegistry ToolRegistry

<div class="tool-call-view">
    <div class="tool-call-icon">
        <ToolIcon Type="tool" CustomSvg="@IconSvg" />
    </div>
    <div class="tool-call-content">
        <div class="tool-call-name">@Invocation.DisplayName</div>
        @if (ShowParameters && Invocation.Parameters.Count > 0)
        {
            <div class="tool-call-parameters">
                @foreach (var param in Invocation.Parameters.Take(3))
                {
                    <span class="tool-param">@param.Key: @FormatValue(param.Value)</span>
                }
                @if (Invocation.Parameters.Count > 3)
                {
                    <span class="tool-param-more">+@(Invocation.Parameters.Count - 3) more</span>
                }
            </div>
        }
    </div>
    @if (Invocation.Permissions.CanRerun)
    {
        <div class="tool-call-actions">
            <button class="tool-action-btn" @onclick="HandleRerun" title="Re-run">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required ToolInvocation Invocation { get; set; }

    [Parameter]
    public bool ShowParameters { get; set; } = true;

    [Parameter]
    public EventCallback OnRerun { get; set; }

    private string IconSvg => ToolRegistry.GetDescriptor(Invocation.Type).GetIconSvg();

    private async Task HandleRerun()
    {
        await OnRerun.InvokeAsync();
    }

    private static string FormatValue(object? value)
    {
        if (value is null) return "null";
        if (value is string s) return Truncate(s, 30);
        if (value is System.Text.Json.JsonElement e && e.ValueKind == System.Text.Json.JsonValueKind.String)
            return Truncate(e.GetString() ?? "", 30);
        return Truncate(value.ToString() ?? "", 30);
    }

    private static string Truncate(string text, int maxLength)
    {
        return text.Length <= maxLength ? text : text[..maxLength] + "…";
    }
}
