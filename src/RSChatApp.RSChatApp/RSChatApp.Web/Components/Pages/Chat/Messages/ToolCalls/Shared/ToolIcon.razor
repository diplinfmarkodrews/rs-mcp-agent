
<div class="tool-icon @GetIconClass()">
    @((MarkupString)GetIconSvg())
</div>

@code {
    [Parameter]
    public string Type { get; set; } = "default";

    [Parameter]
    public string? CustomSvg { get; set; }

    private string GetIconClass()
    {
        return Type.ToLowerInvariant() switch
        {
            "success" => "tool-icon-success",
            "error" => "tool-icon-error",
            "pending" => "tool-icon-pending",
            _ => "tool-icon-default"
        };
    }

    private string GetIconSvg()
    {
        if (!string.IsNullOrWhiteSpace(CustomSvg))
        {
            return CustomSvg;
        }

        return Type.ToLowerInvariant() switch
        {
            "success" => @"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"">
                    <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"" />
                </svg>",
            "error" => @"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"">
                    <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"" />
                </svg>",
            "pending" => @"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"">
                    <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"" />
                </svg>",
            _ => @"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"">
                    <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"" />
                </svg>"
        };
    }
}
