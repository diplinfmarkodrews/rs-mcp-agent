@using System.Text.Json
@using ReportServer.Abstraction.Contracts.Terminal
@using RSChatApp.Shared.Infrastructure.Mcp.ReportServer.Mcp
@using RSChatApp.Web.Models.Chat.ToolCalls

<div class="terminal-result-renderer">
    @if (_error != null)
    {
        <div class="terminal-error">
            <strong>Error:</strong> @_error
        </div>
    }
    else if (_terminalData != null)
    {
        <div class="terminal-entry success">
            <div class="terminal-prompt">@_terminalData.NewPrompt @_terminalData.Command</div>
            <div class="terminal-output">
                <pre>@_terminalData.Result</pre>
                @if (!string.IsNullOrEmpty(_terminalData.Error))
                {
                    <div class="terminal-error">@_terminalData.Error</div>
                }
            </div>
            @if (!string.IsNullOrEmpty(_terminalData.SessionId))
            {
                <div class="terminal-session-info">Session: @_terminalData.SessionId</div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required ToolResult Result { get; set; }

    private string? _error;
    private TerminalViewData? _terminalData;
    private string? _lastCallId;

    protected override void OnParametersSet()
    {
        if (_lastCallId == Result.CallId)
            return;
        
        _lastCallId = Result.CallId;
        _error = null;
        _terminalData = null;

        try
        {
            var rawText = Result.Data switch
            {
                JsonElement e => e.GetProperty("text").GetRawText(),
                string s => JsonElement.Parse(s)
                    .GetProperty("text").GetString(),
                _ => Result.Data?.ToString()
            };
            
            if (string.IsNullOrEmpty(rawText))
            {
                _error = "No terminal output";
                return;
            }
            var commandResult = JsonSerializer.Deserialize<TerminalCommandResult>(rawText, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
            });
            if (commandResult == null)
            {
                _error = "Failed to parse terminal output";
                return;
            }
            _terminalData = new TerminalViewData(commandResult.SessionId, 
                commandResult.Command, 
                commandResult.CmdResult?.Data?.Result ?? string.Empty, 
                commandResult.CmdResult?.Message ?? string.Empty,
                commandResult.CmdResult?.Data?.NewPrompt ?? RsTerminalInfo.Prompt);
        }
        catch (Exception ex)
        {
            _error = $"Failed to parse terminal result: {ex.Message}";
        }
    }

    private record TerminalViewData(string SessionId, string Command, string Result, string Error, string NewPrompt);
}
