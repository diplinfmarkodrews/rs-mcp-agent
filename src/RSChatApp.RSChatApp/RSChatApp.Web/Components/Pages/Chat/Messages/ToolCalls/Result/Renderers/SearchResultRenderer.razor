@using System.Text.RegularExpressions
@using System.Web
@using RSChatApp.Web.Models.Chat.ToolCalls

<div class="search-results">
 
    @foreach (var citation in ParsedCitations)
    {
    var isExpanded = expandedStates.GetValueOrDefault(citation.GetHashCode(), false);
    var viewerUrl = GetViewerUrl(citation);
    <div class="search-result-item">
        <div class="search-result-header">
            <svg class="search-result-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <div class="search-result-file">
                @if (!string.IsNullOrWhiteSpace(viewerUrl))
                {
                    <a href="@viewerUrl" target="_blank" class="citation-link" @onclick:stopPropagation="true">
                        @citation.File
                    </a>
                    @if (citation.Page is not null)
                    {
                        <a href="@viewerUrl" target="_blank" class="search-result-page citation-link" @onclick:stopPropagation="true">
                            page @citation.Page
                        </a>
                    }
                }
                else
                {
                    <span>@citation.File</span>
                    @if (citation.Page is not null)
                    {
                        <span class="search-result-page">page @citation.Page</span>
                    }
                }
            </div>
            <svg class="search-expand-icon @(isExpanded ? "expanded" : "")" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" @onclick="() => ToggleExpanded(citation)">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
        </div>
        
        @if (!string.IsNullOrWhiteSpace(citation.Quote))
        {
            <div class="search-result-preview">
                @GetPreview(citation.Quote)
            </div>
            
            @if (isExpanded)
            {
                <div class="search-result-quote">
                    "@citation.Quote"
                </div>
            }
        }
    </div>
    }
</div>

@code {
    private static readonly Regex CitationRegex = new(
        @"<citation\s+filename=[""'](?<file>[^""']*)[""']\s+page_number=[""'](?<page>\d*)[""']\s*>(?<quote>.*?)</citation>", 
        RegexOptions.Singleline | RegexOptions.NonBacktracking
    );
    
    private readonly record struct CitationData(string File, int? Page, string Quote);
    
    [Parameter, EditorRequired]
    public required object? Data { get; set; }
    
    private List<CitationData> ParsedCitations { get; set; } = new();
    private Dictionary<int, bool> expandedStates = new();
    
    
    protected override void OnParametersSet()
    {
        ParsedCitations.Clear();
        expandedStates.Clear();
        
        var text = Data switch
        {
            string s => s,
            System.Text.Json.JsonElement e when e.ValueKind == System.Text.Json.JsonValueKind.String => e.GetString() ?? "",
            System.Text.Json.JsonElement e when e.ValueKind == System.Text.Json.JsonValueKind.Array =>
                string.Join("", e.EnumerateArray().Select(item => 
                    item.ValueKind == System.Text.Json.JsonValueKind.String ? item.GetString() : item.GetRawText())),
            _ => Data?.ToString() ?? ""
        };
        
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }
        
        foreach (Match match in CitationRegex.Matches(text))
        {
            ParsedCitations.Add(new CitationData(
                match.Groups["file"].Value,
                int.TryParse(match.Groups["page"].Value, out var page) ? page : null,
                match.Groups["quote"].Value
            ));
        }
        
        // Initialize all as collapsed
        foreach (var citation in ParsedCitations)
        {
            expandedStates[citation.GetHashCode()] = false;
        }
    }
    
    private void ToggleExpanded(CitationData citation)
    {
        var key = citation.GetHashCode();
        expandedStates[key] = !expandedStates.GetValueOrDefault(key, false);
    }
    
    private string? GetViewerUrl(CitationData citation)
    {
        // If you ingest other types of content besides PDF files, construct a URL to an appropriate viewer here
        if (citation.File.EndsWith(".pdf"))
        {
            var search = citation.Quote?.Trim('.', ',', ' ', '\n', '\r', '\t', '"', '\'');
            // Don't add /Data/ prefix if the file already contains a path
            var filePath = citation.File.Contains('/') ? citation.File : $"Data/{citation.File}";
            return $"lib/pdf_viewer/viewer.html?file=/{HttpUtility.UrlEncode(filePath)}#page={citation.Page}&search={HttpUtility.UrlEncode(search)}&phrase=true";
        }
        // if (citation.File.EndsWith(".txt"))
        // {
        //     var search = citation.Quote?.Trim('.', ',', ' ', '\n', '\r', '\t', '"', '\'');
        //     var filePath = citation.File.Contains('/') ? citation.File : $"Data/{citation.File}";
        //     return $"lib/text_viewer/viewer.html?file=/{HttpUtility.UrlEncode(filePath)}&search={HttpUtility.UrlEncode(search)}&phrase=true";
        // }
        return null;
    }
    
    private static string GetPreview(string text, int maxLength = 100)
    {
        if (text.Length <= maxLength)
        {
            return text;
        }
        return text.Substring(0, maxLength) + "...";
    }
}
