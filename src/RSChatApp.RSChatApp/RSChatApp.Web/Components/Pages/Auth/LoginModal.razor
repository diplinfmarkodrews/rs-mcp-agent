@using RSChatApp.Web.Models.Auth
@inject NavigationManager Navigation
@inject ILogger<LoginModal> Logger
@inject IJSRuntime JsRuntime

@if (Show)
{
    <div class="modal-backdrop" @onclick="@CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5 class="modal-title">Login to ReportServer</h5>
                <button type="button" class="btn-close" @onclick="@CloseModal" aria-label="Close">×</button>
            </div>
            <div class="modal-body">
                @if (_hasError)
                {
                    <div class="text-center" style="padding: 2rem;">
                        <div style="color: #dc3545; font-size: 48px; margin-bottom: 20px;">⚠</div>
                        <h4 style="color: #dc3545; margin-bottom: 1rem;">Authentication Error</h4>
                        <p style="margin-bottom: 1rem;">@_errorMessage</p>
                        <div style="margin-top: 1.5rem;">
                            <button class="btn-default" @onclick="@RetryAuthentication" style="margin-right: 1rem;">
                                <i class="fas fa-redo me-2"></i>
                                Try Again
                            </button>
                        </div>
                    </div>
                }
                else if (UseLegacyAuth)
                {
                    <LoginForm @bind-Username="_username"
                               @bind-Password="_password"
                               @bind-LoginFrontend="_loginFrontend"
                               IsLoading="_isLoading"
                               OnSubmit="HandleLegacyLogin" />
                }
                else if (_showIframe)
                {
                    <!-- Keycloak Authentication Iframe -->
                    <iframe @ref="_authIframe" 
                            src="@_authUrl" 
                            style="width: 100%; height: 100%; border: none;"
                            @onload="OnIframeLoad">
                    </iframe>
                    @if (_isLoading)
                    {
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(255, 255, 255, 0.8); display: flex; justify-content: center; align-items: center;">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading authentication...</span>
                                </div>
                                <div class="mt-2">Loading authentication...</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center" style="padding: 2rem;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Initializing authentication...</span>
                        </div>
                        <div class="mt-2">Initializing authentication...</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback OnLoginSuccess { get; set; }
    [Parameter] public bool UseLegacyAuth { get; set; } = true; // Option to choose between legacy and Keycloak

    private bool _isLoading = false;
    private bool _showIframe = false;
    private bool _hasError = false;
    private string _errorMessage = "";
    private string _authUrl = "";
    private ElementReference _authIframe;

    // Legacy login form fields
    private string _username = "";
    private string _password = "";
    private bool _loginFrontend = false;

    private async Task CloseModal()
    {
        Show = false;
        _showIframe = false;
        _isLoading = false;
        _hasError = false;
        _errorMessage = "";
        await ShowChanged.InvokeAsync(Show);
    }

    protected override Task OnParametersSetAsync()
    {
        // Reset state and auto-start authentication when modal is shown
        if (Show)
        {
            _isLoading = false;
            _showIframe = false;
            _hasError = false;
            _errorMessage = "";
            
            // Start appropriate authentication based on UseLegacyAuth setting
            if (!UseLegacyAuth)
            {
                // Automatically start the Keycloak authentication process
                LoadKeycloakInIframe();
            }
            // For legacy auth, just show the form (no auto-start needed)
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Show)
        {
            // Add JavaScript to listen for authentication completion
            await JsRuntime.InvokeVoidAsync("setupAuthenticationListener", DotNetObjectReference.Create(this));
        }
    }

    private void LoadKeycloakInIframe()
    {
        try
        {
            _hasError = false;
            _errorMessage = "";
            _isLoading = true;
            StateHasChanged();
            
            // Use the existing auth/challenge endpoint
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var returnUrl = Uri.EscapeDataString($"{baseUrl}/auth/popup-auth-success");
            _authUrl = $"{baseUrl}/auth/challenge?returnUrl={returnUrl}";
            
            Logger.LogInformation("Loading authentication URL: {AuthUrl}", _authUrl);
            
            _showIframe = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Keycloak in iframe");
            ShowError("Failed to initialize authentication. Please check if the authentication service is available and try again.");
        }
    }

    private void RetryAuthentication()
    {
        // Clear any existing error state        
        _hasError = false;
        _errorMessage = "";
        StateHasChanged();

        // Reload the appropriate authentication type
        if (UseLegacyAuth)
        {
            // For legacy auth, just clear the form errors (form is already shown)
            return;
        }
        else
        {
            // Reload Keycloak authentication
            LoadKeycloakInIframe();
        }
    }

    private async Task HandleLegacyLogin()
    {
        // This method will handle the legacy login form submission
        _isLoading = true;
        StateHasChanged();

        try
        {
            // Call the JavaScript function to post the login request
            var loginRequest = new { username = _username, password = _password };
            var result = await JsRuntime.InvokeAsync<LoginResult>("postLoginRequest", loginRequest);

            if (result != null && result.Success)
            {
                Logger.LogInformation("Legacy authentication successful for user {Username}", _username);

                // Refresh the authentication state with reloading the page

                await CloseModal();
                Navigation.Refresh(forceReload: true);
            }
            else
            {
                Logger.LogInformation("Legacy authentication failed for user {Username}. Error: {ErrorMessage}", _username, result?.ErrorMessage);
                ShowError(result?.ErrorMessage ?? "Authentication failed. Please try again.");
                _isLoading = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogError(ex, "Error during legacy authentication");
            ShowError("The request timed out. Please check connection to report server or invalid url.");
            _isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex) 
        {
            
            Logger.LogError(ex, "Error during legacy authentication");
            ShowError($"Authentication failed: {ex.Message}. Please try again");
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private void ShowError(string message)
    {
        _hasError = true;
        _errorMessage = message;
        _isLoading = false;
        _showIframe = false;
        StateHasChanged();
    }

    private async Task OnIframeLoad()
    {
        _isLoading = false;
        StateHasChanged();
        
        // Ensure authentication listener is set up
        await JsRuntime.InvokeVoidAsync("setupAuthenticationListener", DotNetObjectReference.Create(this));
        
        // Start monitoring for authentication completion
        await JsRuntime.InvokeVoidAsync("monitorAuthenticationIframe", _authIframe);
    }

    [JSInvokable]
    public async Task OnAuthenticationSuccess()
    {
        Logger.LogInformation("Authentication successful");
        await OnLoginSuccess.InvokeAsync();
        await CloseModal();
    }

    [JSInvokable]
    public void OnAuthenticationError(string error)
    {
        Logger.LogError("Authentication error: {Error}", error);
        
        // Map common error messages to user-friendly ones
        string userMessage = error.ToLowerInvariant() switch
        {
            var msg when msg.Contains("invalid_request") => "The authentication request was invalid. Please check your configuration.",
            var msg when msg.Contains("access_denied") => "Access was denied. Please check your credentials and permissions.",
            var msg when msg.Contains("server_error") => "The authentication server encountered an error. Please try again later.",
            var msg when msg.Contains("temporarily_unavailable") => "The authentication service is temporarily unavailable. Please try again in a few moments.",
            var msg when msg.Contains("connection") || msg.Contains("network") => "Unable to connect to the authentication service. Please check your network connection.",
            _ => $"Authentication failed: {error}"
        };
        
        ShowError(userMessage);
    }

    [JSInvokable]
    public Task OnConnectionError()
    {
        Logger.LogError("Connection error during authentication");
        ShowError("Unable to connect to the authentication service. Please check if Keycloak is running and accessible.");
        return Task.CompletedTask;
    }

    [JSInvokable]
    public void OnAuthenticationRetry()
    {
        Logger.LogInformation("User requested authentication retry");
        RetryAuthentication();
    }

    [JSInvokable]
    public async Task OnAuthenticationClose()
    {
        Logger.LogInformation("User requested to close authentication");
        await CloseModal();
    }
}
