{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "RSChatApp.ServiceDefaults.Authentication": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReportServer": {
    "Url": "http://localhost:8080/reportserver",
    "SessionTimeout": "01:00:00",
    "CookieDomain": "localhost",
    "EnableSessionBridge": false
  },
  "OpenAISettings": {
    "Model": "claude-sonnet-4-5",
    "Url": "https://api.anthropic.com/v1/",
    "ApiKey": "ANTHROPIC_KEY"
  },
  "OpenAIPromptExecutionSettings": {
    "MaxTokens": 8192,
    "Temperature": 0.7,
    "TopP": 1.0,
    "FrequencyPenalty": 0.0,
    "PresencePenalty": 0.0,
    "AllowMultipleToolCalls": true
  },
  "Qdrant": {
    "Url": "http://localhost:6334"
  },
  "RsMcpServer": {
    "Url": "http://localhost:5002"
  },
  "McpClientSettings": {
    "Clients": [
      {
        "Name": "SequentialThinking",
        "Command": "npx",
        "Arguments": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
      }
    ]
  },
  "Keycloak": {
    "Authority": "http://localhost:8090/realms/reportserver",
    "ClientId": "rs-chat-app",
    "ClientSecret": "",
    "Realm": "reportserver",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "roles"
    ],
    "RequireHttpsMetadata": true,
    "TokenRefreshThreshold": "00:05:00"
  },
  "StaticContent": {
    "Sources": [
      {
        "Name": "rs-scripts",
        "Path": "../../../scripts/rs-scripts",
        "RequestPath": "/rs-scripts",
        "CacheMaxAgeSeconds": 3600,
        "IncludeExtensions": [
          ".groovy",
          ".cf",
          ".properties",
          ".md",
          ".txt",
          ".json",
          ".xml",
          ".yml",
          ".yaml"
        ]
      }
    ]
  }
}
