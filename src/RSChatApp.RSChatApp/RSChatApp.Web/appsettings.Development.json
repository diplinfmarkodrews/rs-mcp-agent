{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",      
      "RSChatApp": "Debug",
      "RSChatApp.Web": "Debug",
      "Microsoft.Extensions.AI": "Debug",
      "RSChatApp.ServiceDefaults.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "DetailedErrors": true,
  "OpenAISettings": {
    "Model": "claude-sonnet-4-6",
    "Url": "https://api.anthropic.com/v1/",
    "ApiKey": "ANTHROPIC_KEY"
  },
  "OpenAIPromptExecutionSettings": {
    "MaxTokens": 8192,
    "Temperature": 0.1,
    "TopP": 0.5,
    "FrequencyPenalty": 0.0,
    "PresencePenalty": 0.0,
    "AllowMultipleToolCalls": true
  },
  "ReportServer": {
    "Url": "http://localhost:8080/reportserver",
    "SessionTimeout": "01:00:00",
    "CookieDomain": "localhost",
    "EnableSessionBridge": false
  },
  "RsMcpServer": {
    "Url": "http://localhost:5002"
  },
  "McpClientSettings": {
    "Clients": [
    ]
  },
  "AllowedCorsOrigins": [
    "http://localhost:5008",
    "https://localhost:5008",
    "http://localhost:8090",
    "https://reportserver.net"
  ],
  "SessionCookieSettings": {
    "IdleTimeout": 180
  },
  "Keycloak": {
    "Authority": "http://localhost:8090/realms/reportserver",
    "ClientId": "rs-chat-app",
    "ClientSecret": "",
    "Realm": "reportserver",
    "Scopes": [
      "openid",
      "profile",
      "email",
      "roles",
      "offline_access"
    ],
    "RequireHttpsMetadata": false,
    "TokenRefreshThreshold": "00:05:00",
    "UsePkce": true,
    "UsePar": false
  },
  "BrowserInstanceConfiguration": {
    "Headless": false,
    "SlidingExpirationMinutes": 20
  },
  "StaticContent": {
    "Sources": [
      {
        "Name": "rs-scripts",
        "Path": "../../../scripts/rs-scripts",
        "RequestPath": "/rs-scripts",
        "CacheMaxAgeSeconds": 3600,
        "IncludeExtensions": [
          ".groovy",
          ".cf",
          ".properties",
          ".md",
          ".txt",
          ".json",
          ".xml",
          ".yml",
          ".yaml"
        ]
      },
      {
        "Name": "skills",
        "Path": "../../../scripts/skills",
        "RequestPath": "/skills",
        "CacheMaxAgeSeconds": 3600,
        "IncludeExtensions": [
          ".md",
          ".txt"
        ]
      }
    ]
  }
}
