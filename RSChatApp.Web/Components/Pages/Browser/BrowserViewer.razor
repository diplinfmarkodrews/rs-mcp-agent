@using Microsoft.Playwright
@using RSChatApp.Mcp.Browser.Core
@inject IBrowserInstanceProvider BrowserProvider
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="browser-viewer">
    <!-- Browser Controls -->
    <div class="browser-controls">
        <div class="navigation-bar">
            <button @onclick="GoBack" disabled="@(!canGoBack)" title="Back">⬅️</button>
            <button @onclick="GoForward" disabled="@(!canGoForward)" title="Forward">➡️</button>
            <button @onclick="Refresh" title="Refresh">🔄</button>
            
            <input @bind="navigationUrl" 
                   @onkeypress="HandleKeyPress" 
                   @onfocus="SelectUrl"
                   class="url-input" 
                   placeholder="Enter URL..." />
            
            <button @onclick="NavigateToUrl" class="go-button">Go</button>
        </div>
        
        <div class="page-info">
            <span class="page-title">@pageTitle</span>
            @if (isLoading)
            {
                <span class="loading-indicator">🔄 Loading...</span>
            }
        </div>
    </div>

    <!-- Page Content -->
    <div class="page-container">
        @if (!string.IsNullOrEmpty(pageContent))
        {
            <iframe srcdoc="@pageContent" 
                    class="page-frame"
                    sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-top-navigation"
                    @onload="OnPageLoaded">
            </iframe>
        }
        else if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading page...</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🌐</div>
                <h3>No page loaded</h3>
                <p>Enter a URL above to get started</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    [Parameter] public EventCallback<string> OnPageTitleChanged { get; set; }
    [Parameter] public string InitialUrl { get; set; } = "";

    private IBrowserInstance? browserInstance;
    private IPage? page;
    
    private string navigationUrl = "";
    private string pageContent = "";
    private string pageTitle = "";
    private string currentUrl = "";
    
    private bool isLoading = false;
    private bool canGoBack = false;
    private bool canGoForward = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            browserInstance = BrowserProvider.GetBrowserInstance();
            page = browserInstance.Page;
            
            // Set up page event handlers
            page.Load += OnPageLoadEvent;
            page.DOMContentLoaded += OnDOMContentLoaded;
            page.FrameNavigated += OnFrameNavigated;
            
            // Navigate to initial URL if provided
            if (!string.IsNullOrEmpty(InitialUrl))
            {
                navigationUrl = InitialUrl;
                await NavigateToUrl();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing browser: {ex.Message}");
            // Show error in the UI
            pageContent = $"<html><body><h1>Browser Initialization Error</h1><p>{ex.Message}</p></body></html>";
            StateHasChanged();
        }
    }

    private async Task NavigateToUrl()
    {
        if (page == null || string.IsNullOrWhiteSpace(navigationUrl)) 
            return;

        try
        {
            isLoading = true;
            StateHasChanged();

            // Ensure URL has protocol
            if (!navigationUrl.StartsWith("http://") && !navigationUrl.StartsWith("https://"))
            {
                navigationUrl = "https://" + navigationUrl;
            }

            await page.GotoAsync(navigationUrl, new PageGotoOptions 
            { 
                WaitUntil = WaitUntilState.DOMContentLoaded,
                Timeout = 30000
            });

            await UpdatePageContent();
            await OnNavigate.InvokeAsync(navigationUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Navigation error: {ex.Message}");
            pageContent = $"<html><body><h1>Navigation Error</h1><p>Failed to load: {navigationUrl}</p><p>Error: {ex.Message}</p></body></html>";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task UpdatePageContent()
    {
        if (page == null) return;

        try
        {
            // Get page content and metadata
            pageContent = await page.ContentAsync();
            pageTitle = await page.TitleAsync();
            currentUrl = page.Url;
            navigationUrl = currentUrl;

            // Update navigation state
            await UpdateNavigationState();

            // Sanitize content for iframe
            pageContent = SanitizeContent(pageContent);

            await OnPageTitleChanged.InvokeAsync(pageTitle);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating content: {ex.Message}");
            pageContent = $"<html><body><h1>Content Update Error</h1><p>{ex.Message}</p></body></html>";
            StateHasChanged();
        }
    }

    private string SanitizeContent(string html)
    {
        if (string.IsNullOrEmpty(html)) return html;

        try
        {
            // Add base tag for relative URLs
            var baseUrl = new Uri(currentUrl).GetLeftPart(UriPartial.Authority);
            html = html.Replace("<head>", $"<head><base href='{baseUrl}'>");

            // Add CSP for security
            var csp = "default-src 'self' data: https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:;";
            html = html.Replace("<head>", $"<head><meta http-equiv='Content-Security-Policy' content='{csp}'>");

            return html;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sanitizing content: {ex.Message}");
            return html; // Return original if sanitization fails
        }
    }

    private async Task UpdateNavigationState()
    {
        if (page == null) return;

        try
        {
            // Check if we can go back/forward
            // Note: Playwright doesn't have direct canGoBack/canGoForward
            // This is a simplified implementation
            canGoBack = !string.IsNullOrEmpty(currentUrl);
            canGoForward = false; // Would need history tracking for full implementation
        }
        catch
        {
            canGoBack = false;
            canGoForward = false;
        }
    }

    private async Task GoBack()
    {
        if (page == null) return;
        
        try
        {
            await page.GoBackAsync();
            await UpdatePageContent();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Go back error: {ex.Message}");
        }
    }

    private async Task GoForward()
    {
        if (page == null) return;
        
        try
        {
            await page.GoForwardAsync();
            await UpdatePageContent();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Go forward error: {ex.Message}");
        }
    }

    private async Task Refresh()
    {
        if (page == null) return;
        
        try
        {
            isLoading = true;
            StateHasChanged();
            
            await page.ReloadAsync();
            await UpdatePageContent();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Refresh error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await NavigateToUrl();
        }
    }

    private async Task SelectUrl()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("selectText", ".url-input");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error selecting URL text: {ex.Message}");
        }
    }

    private async Task OnPageLoaded()
    {
        // Optional: Handle iframe load event
        try
        {
            await JSRuntime.InvokeVoidAsync("console.log", "Page loaded in iframe");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in iframe load handler: {ex.Message}");
        }
    }

    // Page event handlers
    private async void OnPageLoadEvent(object? sender, IPage page)
    {
        await InvokeAsync(async () =>
        {
            await UpdatePageContent();
        });
    }

    private async void OnDOMContentLoaded(object? sender, IPage page)
    {
        await InvokeAsync(async () =>
        {
            isLoading = false;
            await UpdatePageContent();
        });
    }

    private async void OnFrameNavigated(object? sender, IFrame frame)
    {
        if (frame == page?.MainFrame)
        {
            await InvokeAsync(async () =>
            {
                await UpdatePageContent();
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (page != null)
            {
                page.Load -= OnPageLoadEvent;
                page.DOMContentLoaded -= OnDOMContentLoaded;
                page.FrameNavigated -= OnFrameNavigated;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing browser viewer: {ex.Message}");
        }
    }
}
