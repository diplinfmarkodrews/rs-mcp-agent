@using Microsoft.AspNetCore.SignalR.Client
@using RSChatApp.Web.Services.Browser
@inject IJSRuntime JSRuntime
@inject IBrowserStreamingService BrowserStreamingService
@implements IAsyncDisposable

<div class="browser-streaming-viewer">
    <!-- Browser Controls -->
    <div class="browser-controls">
        <div class="navigation-bar">
            <button @onclick="GoBack" disabled="@(!canGoBack)" title="Back">⬅️</button>
            <button @onclick="GoForward" disabled="@(!canGoForward)" title="Forward">➡️</button>
            <button @onclick="Refresh" title="Refresh">🔄</button>
            
            <input @bind="navigationUrl" 
                   @onkeypress="HandleKeyPress" 
                   @onfocus="SelectUrl"
                   class="url-input" 
                   placeholder="Enter URL..." />
            
            <button @onclick="NavigateToUrl" class="go-button">Go</button>
            
            @if (sessionInfo != null)
            {
                <button @onclick="ToggleStreaming" 
                        class="@(sessionInfo.IsStreaming ? "stop-button" : "start-button")" 
                        title="@(sessionInfo.IsStreaming ? "Stop Streaming" : "Start Streaming")">
                    @(sessionInfo.IsStreaming ? "⏹️" : "▶️")
                </button>
            }
        </div>
        
        <div class="status-bar">
            @if (sessionInfo != null)
            {
                <span class="page-title">@sessionInfo.Title</span>
                <span class="session-info">Session: @sessionInfo.SessionId</span>
                <span class="streaming-status @(sessionInfo.IsStreaming ? "streaming" : "stopped")">
                    @(sessionInfo.IsStreaming ? "🔴 Live" : "⚫ Stopped")
                </span>
            }
            
            @if (isConnecting)
            {
                <span class="loading-indicator">🔄 Connecting...</span>
            }
        </div>
    </div>

    <!-- Live Stream Content -->
    <div class="stream-container">
        @if (!string.IsNullOrEmpty(currentFrame))
        {
            <div class="frame-container">
                <img src="@currentFrame" 
                     alt="Live Browser Stream" 
                     class="stream-frame"
                     @onclick="OnFrameClick"
                     @oncontextmenu="OnFrameRightClick"
                     @oncontextmenu:preventDefault="true"
                     @onmousemove="OnMouseMove"
                     @onmousedown="OnMouseDown"
                     @onmouseup="OnMouseUp" />
                
                <!-- Mouse cursor indicator -->
                @if (showCursor)
                {
                    <div class="mouse-cursor" style="left: @(mouseX)px; top: @(mouseY)px;"></div>
                }
            </div>
        }
        else if (isConnecting)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Starting browser session...</p>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🌐</div>
                <h3>Browser Stream Ready</h3>
                <p>Enter a URL and start streaming to begin</p>
            </div>
        }
    </div>

    <!-- Debug Panel (optional) -->
    @if (showDebugPanel)
    {
        <div class="debug-panel">
            <h4>Debug Information</h4>
            <div class="debug-info">
                <div>Connection State: @connectionState</div>
                <div>Session ID: @sessionId</div>
                <div>Frame Rate: @frameRate FPS</div>
                <div>Last Frame: @lastFrameTime?.ToString("HH:mm:ss.fff")</div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string InitialUrl { get; set; } = "";
    [Parameter] public EventCallback<string> OnNavigate { get; set; }
    [Parameter] public EventCallback<string> OnPageTitleChanged { get; set; }
    [Parameter] public bool ShowDebugPanel { get; set; } = false;

    private HubConnection? hubConnection;
    private string sessionId = "";
    private string navigationUrl = "";
    private string currentFrame = "";
    private BrowserSessionInfo? sessionInfo;
    
    private bool isConnecting = false;
    private bool canGoBack = false;
    private bool canGoForward = false;
    private bool showCursor = true;
    private bool showDebugPanel = false;
    
    private double mouseX = 0;
    private double mouseY = 0;
    private string connectionState = "Disconnected";
    private int frameRate = 0;
    private DateTime? lastFrameTime;
    private Timer? frameRateTimer;

    protected override async Task OnInitializedAsync()
    {
        showDebugPanel = ShowDebugPanel;
        
        // Initialize SignalR connection
        hubConnection = new HubConnectionBuilder()
            .WithUrl("/browserstreamhub")
            .WithAutomaticReconnect()
            .Build();

        // Set up event handlers
        hubConnection.On<string>("FrameUpdate", OnFrameReceived);
        hubConnection.On<object>("PageUpdate", OnPageUpdate);
        hubConnection.On<string>("BrowserError", OnBrowserError);
        hubConnection.On<string>("UserJoined", OnUserJoined);
        hubConnection.On<string>("UserLeft", OnUserLeft);

        hubConnection.Reconnecting += (error) =>
        {
            InvokeAsync(() =>
            {
                connectionState = "Reconnecting";
                StateHasChanged();
            });
            return Task.CompletedTask;
        };

        hubConnection.Reconnected += (connectionId) =>
        {
            InvokeAsync(async () =>
            {
                connectionState = "Connected";
                if (!string.IsNullOrEmpty(sessionId))
                {
                    await hubConnection.SendAsync("JoinBrowserSession", sessionId);
                }
                StateHasChanged();
            });
            return Task.CompletedTask;
        };

        hubConnection.Closed += (error) =>
        {
            InvokeAsync(() =>
            {
                connectionState = "Disconnected";
                StateHasChanged();
            });
            return Task.CompletedTask;
        };

        await StartConnection();

        // Set up frame rate monitoring
        frameRateTimer = new Timer(UpdateFrameRate, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task StartConnection()
    {
        try
        {
            isConnecting = true;
            connectionState = "Connecting";
            StateHasChanged();

            await hubConnection!.StartAsync();
            connectionState = "Connected";

            // Create streaming session
            sessionId = await BrowserStreamingService.CreateStreamingSessionAsync(InitialUrl);
            await hubConnection.SendAsync("JoinBrowserSession", sessionId);

            // Get initial session info
            sessionInfo = await BrowserStreamingService.GetSessionInfoAsync(sessionId);

            if (!string.IsNullOrEmpty(InitialUrl))
            {
                navigationUrl = InitialUrl;
                await NavigateToUrl();
            }
        }
        catch (Exception ex)
        {
            connectionState = $"Error: {ex.Message}";
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task NavigateToUrl()
    {
        if (string.IsNullOrWhiteSpace(navigationUrl) || string.IsNullOrEmpty(sessionId))
            return;

        try
        {
            await BrowserStreamingService.NavigateAsync(sessionId, navigationUrl);
            await OnNavigate.InvokeAsync(navigationUrl);
        }
        catch (Exception ex)
        {
            await OnBrowserError($"Navigation failed: {ex.Message}");
        }
    }

    private async Task ToggleStreaming()
    {
        if (sessionInfo == null) return;

        try
        {
            if (sessionInfo.IsStreaming)
            {
                await BrowserStreamingService.StopStreamingAsync(sessionId);
            }
            else
            {
                await BrowserStreamingService.StartStreamingAsync(sessionId);
            }

            // Update session info
            sessionInfo = await BrowserStreamingService.GetSessionInfoAsync(sessionId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await OnBrowserError($"Failed to toggle streaming: {ex.Message}");
        }
    }

    private async Task GoBack()
    {
        await SendInteraction("keypress", new { key = "ArrowLeft", altKey = true });
    }

    private async Task GoForward()
    {
        await SendInteraction("keypress", new { key = "ArrowRight", altKey = true });
    }

    private async Task Refresh()
    {
        await SendInteraction("keypress", new { key = "F5" });
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await NavigateToUrl();
        }
    }

    private async Task SelectUrl()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("selectText", ".url-input");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error selecting URL text: {ex.Message}");
        }
    }

    private async Task OnFrameClick(MouseEventArgs e)
    {
        await SendInteraction("click", new { x = e.OffsetX, y = e.OffsetY });
    }

    private async Task OnFrameRightClick(MouseEventArgs e)
    {
        await SendInteraction("click", new { x = e.OffsetX, y = e.OffsetY, button = "right" });
    }

    private async Task OnMouseMove(MouseEventArgs e)
    {
        mouseX = e.OffsetX;
        mouseY = e.OffsetY;
        
        if (hubConnection != null)
        {
            await hubConnection.SendAsync("SendMouseMove", sessionId, mouseX, mouseY);
        }
    }

    private async Task OnMouseDown(MouseEventArgs e)
    {
        // Handle mouse down for drag operations
        await Task.CompletedTask;
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        // Handle mouse up for drag operations
        await Task.CompletedTask;
    }

    private async Task SendInteraction(string type, object data)
    {
        if (hubConnection != null && !string.IsNullOrEmpty(sessionId))
        {
            try
            {
                await hubConnection.SendAsync("SendInteraction", sessionId, type, data);
            }
            catch (Exception ex)
            {
                await OnBrowserError($"Failed to send interaction: {ex.Message}");
            }
        }
    }

    // SignalR event handlers
    private async Task OnFrameReceived(string frameData)
    {
        await InvokeAsync(() =>
        {
            currentFrame = frameData;
            lastFrameTime = DateTime.Now;
            frameRate++;
            StateHasChanged();
        });
    }

    private async Task OnPageUpdate(object pageInfo)
    {
        await InvokeAsync(async () =>
        {
            // Update session info
            sessionInfo = await BrowserStreamingService.GetSessionInfoAsync(sessionId);
            
            if (sessionInfo != null)
            {
                navigationUrl = sessionInfo.Url;
                await OnPageTitleChanged.InvokeAsync(sessionInfo.Title);
            }
            
            StateHasChanged();
        });
    }

    private async Task OnBrowserError(string error)
    {
        await InvokeAsync(() =>
        {
            // Handle browser errors - could show toast notifications
            Console.WriteLine($"Browser error: {error}");
            StateHasChanged();
        });
    }

    private async Task OnUserJoined(string connectionId)
    {
        await InvokeAsync(() =>
        {
            // Handle user joined - could show collaboration indicators
            StateHasChanged();
        });
    }

    private async Task OnUserLeft(string connectionId)
    {
        await InvokeAsync(() =>
        {
            // Handle user left
            StateHasChanged();
        });
    }

    private void UpdateFrameRate(object? state)
    {
        InvokeAsync(() =>
        {
            frameRate = 0; // Reset for next second
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        frameRateTimer?.Dispose();
        
        if (hubConnection != null)
        {
            if (!string.IsNullOrEmpty(sessionId))
            {
                await hubConnection.SendAsync("LeaveBrowserSession", sessionId);
                await BrowserStreamingService.CloseStreamingSessionAsync(sessionId);
            }
            
            await hubConnection.DisposeAsync();
        }
    }
}
