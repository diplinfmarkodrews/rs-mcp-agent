@page "/"

@attribute [AllowAnonymous]
@inject IChatClient ChatClient
@inject Kernel Kernel
@inject NavigationManager Nav
@inject SemanticSearch Search
@inject IAuthenticationInfoService AuthenticationInfoService
@inject ILoginModalService LoginModalService
@inject IChatHistoryService ChatHistoryService
@inject ILogger<Chat> Logger
@using System.ComponentModel
@using System.Diagnostics.CodeAnalysis
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using RSChatApp.Web.Services.Authentication
@using RSChatApp.Web.Services.ChatHistory
@using RSChatApp.Web.Services.SemanticSearch
@using ChatMessage = Microsoft.Extensions.AI.ChatMessage
@using TextContent = Microsoft.Extensions.AI.TextContent
@implements IDisposable

<div class="chat-page">
    <ChatHeader OnNewChat="@ResetConversationAsync" />
    
    <div class="chat-messages-area">
        <ChatMessageList Messages="@messages" InProgressMessage="@currentResponseMessage">
            <NoMessagesContent>
                <div>Welcome to the ReportServer Agent.</div>
                <ChatCitation File="ReportServer-5_0-ConfigurationGuide-En.pdf"/>
                <ChatCitation File="ReportServer-5_0-UserGuide-De.pdf"/>
                <ChatCitation File="ReportServer-5_0-AdminGuide-En.pdf"/>
                <ChatCitation File="ReportServer-5_0-ScriptGuide-En.pdf"/>
            </NoMessagesContent>
        </ChatMessageList>
    </div>

    <div class="chat-container">
        <div class="chat-suggestions">
            <ChatSuggestions OnSelected="@AddUserMessageAsync" @ref="@chatSuggestions"/>
        </div>
        <div class="chat-input">
            <ChatInput OnSend="@AddUserMessageAsync" @ref="@chatInput"/>
        </div>
    </div>
</div>

@code {
    private const string SystemPrompt = @"
        You are an assistant for the ReportServer and a omnipotent groovy script developer. 

        Use the search tool to find relevant information in documentation, 
        scripts and terminal commands. 
        The documentation consists of the following files:
        - ReportServer-5_0-ConfigurationGuide-En.pdf
        - ReportServer-5_0-UserGuide-De.pdf
        - ReportServer-5_0-AdminGuide-En.pdf
        - ReportServer-5_0-ScriptGuide-En.pdf
         
        Respect the language of each document, which is reflected by its ending En(english) or De(German). 
        You have a browsertool to have full control of the Reportserver front end. 
        The official reportserver documentation is available at 'https://reportserver.net/de/dokumentation'
        Its the content of your knowledgebase, found in Searchtool.
        ";

    private readonly ChatOptions chatOptions = new();
    private readonly List<ChatMessage> messages = new();
    private CancellationTokenSource? currentResponseCancellation;
    private ChatMessage? currentResponseMessage;
    private ChatInput? chatInput;
    private ChatSuggestions? chatSuggestions;
    private bool IsOllama;
    
    [Experimental("SKEXP0001")]
    protected override async Task OnInitializedAsync()
    {
        // Since new ollama version supports stream & toolcalls, will refactor to stream api only
        // TODO: Test first with ollama version that supports both streaming and toolcalls
        IsOllama = false;
        await InitChatHistoryAsync();
        
        // Debug logging to see what kernel plugins are available
        var kernelPlugins = Kernel.Plugins.ToList();
        Logger.LogDebug("Total kernel plugins available: {kernelPluginsCount}", kernelPlugins.Count);

        // Create a list of all tools (local search + MCP tools)
        var allTools = new List<AITool>
        {
            AIFunctionFactory.Create(SearchAsync,  "Search", "Search for information using a phrase or keyword"),
            AIFunctionFactory.Create(IsAuthenticatedAsync, "IsAuthenticated", "Checks whether the user is authenticated against the ReportServer and can execute ReportServerMcp tools or not"),
            @* AIFunctionFactory.Create(LoginUserRequestedAsync, "RequestLogin", "Requests the user to login when they need to access ReportServer MCP tools but are not authenticated") *@
        };
        
        // Add MCP tools
        foreach (var plugin in kernelPlugins)
        {
            foreach (var aiFunction in plugin)
            {
                allTools.Add(
                    aiFunction.AsKernelFunction()
                        .WithKernel(Kernel));
            }
        }
        Logger.LogInformation("Total tools registered for chat: {allToolsCount}", allTools.Count);
        chatOptions.Tools = allTools;
    }
    public async Task StoreChatHistoryAsync()
    {
        try
        {
            await ChatHistoryService.SaveHistoryAsync(messages);
            Logger.LogInformation("Chat history saved with {messageCount} messages", messages.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving chat history");
        }
    }
    private async Task InitChatHistoryAsync()
    {
        var chatHistory = await ChatHistoryService.LoadHistoryAsync();
        messages.Clear();
        if (chatHistory.Count > 0)
        {
            Logger.LogInformation("Loaded {chatHistoryCount} messages from chat history", chatHistory.Count);
            messages.AddRange(chatHistory);
            chatSuggestions?.Update(messages);
            await InvokeAsync(StateHasChanged);
            await chatInput!.FocusAsync();
        }
        else
        {
            Logger.LogInformation("No chat history found, starting new conversation");
            messages.Add(new(ChatRole.System, SystemPrompt));
        }
    }
    
    private Task AddUserMessageAsync(ChatMessage userMessage)
    {
        if (IsOllama)
            return AddUserMessageSingleAsync(userMessage);
        
        return AddUserMessageStreamAsync(userMessage);

    }
    private async Task AddUserMessageSingleAsync(ChatMessage userMessage)
    {
        CancelAnyCurrentResponse();

        // Add the user message to the conversation
        messages.Add(userMessage);
        chatSuggestions?.Clear();
        await chatInput!.FocusAsync();

        try
        {
            // Display a new response from the IChatClient, streaming responses
            // aren't supported because Ollama will not support both streaming and using Tools
            currentResponseCancellation = new();
            var response = await ChatClient.GetResponseAsync(messages, chatOptions, currentResponseCancellation.Token);

            // Store responses in the conversation, and begin getting suggestions
            messages.AddMessages(response);
            chatSuggestions?.Update(messages);
        }
        catch (OperationCanceledException)
        {
            // Handle cancellation gracefully - conversation is preserved
            Logger.LogDebug("Chat response was cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during chat response");
            
            // Add error message to chat
            var errorMessage = new ChatMessage(ChatRole.Assistant, 
                $"Sorry, I encountered an error while processing your request: {ex.Message}");
            messages.Add(errorMessage);
            
            // Update suggestions and UI
            chatSuggestions?.Update(messages);
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task AddUserMessageStreamAsync(ChatMessage userMessage)
    {
        CancelAnyCurrentResponse();

        // Add the user message to the conversation
        messages.Add(userMessage);
        chatSuggestions?.Clear();
        await chatInput!.FocusAsync();

        // Display a new response from the IChatClient with streaming
        currentResponseCancellation = new();
        
        // Initialize streaming response message
        currentResponseMessage = new ChatMessage(ChatRole.Assistant, string.Empty);
        var contentBuilder = new StringBuilder();

        try
        {
            // Use streaming API to get progressive responses ChatClient.GetStreamingResponseAsync(
            await foreach (var update in ChatClient.GetStreamingResponseAsync(messages, chatOptions, currentResponseCancellation.Token))
            {
                // Handle different types of streaming updates
                foreach (var content in update.Contents)
                {
                    // Only append text content, ignore tool calls and other content types
                    if (content is TextContent textContent)
                    {
                        contentBuilder.Append(textContent.Text);
                        
                        // Update the current response message with accumulated content
                        currentResponseMessage = new ChatMessage(ChatRole.Assistant, contentBuilder.ToString());
                        
                        // Trigger UI update to show streaming content
                        await InvokeAsync(StateHasChanged);
                    }
                    // Note: Tool calls and other content types are handled by the underlying system
                    // and will be included in the final complete message
                }
                
                // Check for cancellation
                currentResponseCancellation.Token.ThrowIfCancellationRequested();
            }

            // Finalize the response - add the complete message to conversation
            if (currentResponseMessage != null && !string.IsNullOrEmpty(currentResponseMessage.Text))
            {
                messages.Add(currentResponseMessage);
            }
        }
        catch (OperationCanceledException)
        {
            // Handle cancellation gracefully
            if (currentResponseMessage != null && !string.IsNullOrEmpty(currentResponseMessage.Text))
            {
                messages.Add(currentResponseMessage);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during streaming chat response");
            
            // Add any partial response that was being built
            if (currentResponseMessage != null && !string.IsNullOrEmpty(currentResponseMessage.Text))
            {
                messages.Add(currentResponseMessage);
            }
            
            // Add error message to chat - ensure it's added to the conversation
            var errorMessage = new ChatMessage(ChatRole.Assistant, 
                $"Sorry, I encountered an error while processing your request: {ex.Message}");
            messages.Add(errorMessage);
            
            // Force UI update to show the error message
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            // Clear the in-progress message and update suggestions
            currentResponseMessage = null;
            chatSuggestions?.Update(messages);
            await StoreChatHistoryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelAnyCurrentResponse()
    {
        // If a response was cancelled while streaming, include it in the conversation so it's not lost
        if (currentResponseMessage is not null)
        {
            messages.Add(currentResponseMessage);
        }

        // Cancel the current operation if it exists
        if (currentResponseCancellation != null && !currentResponseCancellation.Token.IsCancellationRequested)
        {
            currentResponseCancellation?.Cancel();
        }
        currentResponseMessage = null;
    }

    private async Task ResetConversationAsync()
    {
        CancelAnyCurrentResponse();
        messages.Clear();
        await ChatHistoryService.ClearHistoryAsync();
        chatSuggestions?.Clear();
        messages.Add(new(ChatRole.System, SystemPrompt));
        await chatInput!.FocusAsync();
    }


  
    [Description("Searches for information using a phrase or keyword")]
    private async Task<IEnumerable<string>> SearchAsync(
        [Description("The phrase to search for.")] string searchPhrase,
        [Description("If possible, specify the filename to search that file only. If not provided or empty, the search includes all files.")] string? filenameFilter = null,
        [Description("The maximum number of results to return. Default is 17.")] int maxResults = 17)
    {
        await InvokeAsync(StateHasChanged);
        var results = await Search.SearchAsync(searchPhrase, filenameFilter, maxResults);
        return results.Select(result =>
            $"<result filename=\"{result.DocumentId}\" page_number=\"{result.PageNumber}\">{result.Text}</result>");
    }
    
    [Description("Checks whether the user is authenticated against the ReportServer and can execute ReportServerMcp tools or not")]
    private async Task<string> IsAuthenticatedAsync()
    {
        await InvokeAsync(StateHasChanged);
        // Check User authentication status and build a response
        var authResult = await AuthenticationInfoService.GetAuthenticationInfoAsync();
        return authResult.IsAuthenticated 
            ? new StringBuilder("User: ")
                .Append(authResult.UserName)
                .Append(" is authenticated with roles: ")
                .AppendJoin(',', authResult.Roles)
                .ToString() 
            : "User is not authenticated";
    }
    
    [Description("Requests the user to login when they need to access ReportServer MCP tools but are not authenticated")]
    private async Task<string> LoginUserRequestedAsync()
    {
        await InvokeAsync(StateHasChanged);
        // Request login through the service and wait for the result
        try
        {
            var loginSuccessful = await LoginModalService.RequestLoginAsync();
            if (loginSuccessful)
            {
                // Re-check authentication status after successful login
                return await IsAuthenticatedAsync();
            }
            
            return "Login was cancelled or failed. Please try again to access ReportServer MCP tools.";
            
        }
        catch (Exception exc)
        {
            Logger.LogError(exc, "Error during login request");
            return new StringBuilder("An error occurred while requesting login. Please try again later.")
                .Append(exc.Message)
                .ToString();
        }
    }
    public void Dispose()
        => currentResponseCancellation?.Cancel();
}

