@page "/dual"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@using RSChatApp.Mcp.Browser.Configuration
@using RSChatApp.Web.Components.Pages.Browser
@using RSChatApp.Web.Components.Pages.Chat
@inject IOptions<BrowserInstanceConfiguration> BrowserOptions
<div class="cockpit-container">
    <div class="browser-section">
        <BrowserViewer InitialUrl="@BrowserOptions.Value.BaseUrl" 
                       OnNavigate="HandleNavigation"
                       
                       OnPageTitleChanged="HandleTitleChanged" />
    </div>
    <div class="chat-section">
        <Chat />
    </div>
</div>

@code {
    private void HandleNavigation(string url)
    {
        Console.WriteLine($"Navigated to: {url}");
    }

    private void HandleTitleChanged(string title)
    {
        Console.WriteLine($"Page title changed: {title}");
    }
}
