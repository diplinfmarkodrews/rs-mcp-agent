@using RSChatApp.Web.Models.Terminal
@using RSChatApp.Web.Services.Terminal

<div class="terminal-viewer">
    @if (Terminal != null)
    {
        <div class="terminal-output" @ref="_outputContainer">
            @foreach (var entry in Terminal.CommandHistory.Where(e => !e.IsSeeded))
            {
                <div class="terminal-entry @(entry.IsSuccess ? "success" : "error")">
                    <div class="terminal-prompt">@GetPrompt() @entry.Command</div>
                    <div class="terminal-result">
                        <pre>@entry.Output</pre>
                        @if (!string.IsNullOrEmpty(entry.Error))
                        {
                            <div class="terminal-error">@entry.Error</div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="terminal-input-container">
            <span class="terminal-prompt-indicator">@GetPrompt()</span>
            <input type="text" 
                   class="terminal-input" 
                   @bind="_currentCommand"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown"
                   disabled="@_isExecuting"
                   placeholder="Enter command..."
                   @ref="_inputElement" />
            @if (_isExecuting)
            {
                <span class="terminal-spinner">⏳</span>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public TerminalInstance? Terminal { get; set; }
    
    
    [Parameter]
    public EventCallback<CommandEntry> OnCommandExecuted { get; set; }

    [Inject]
    private ITerminalManager TerminalManager { get; set; } = default!;

    private ElementReference _inputElement;
    private ElementReference _outputContainer;
    private string _currentCommand = string.Empty;
    private bool _isExecuting;

    public async Task SetCommandAsync(string command, CancellationToken token = default)
    {
        _currentCommand = command;
        await InvokeAsync(StateHasChanged);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Terminal != null)
        {
            await _inputElement.FocusAsync();
        }
        
        // Auto-scroll to bottom after rendering
        if (_outputContainer.Context != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollToBottom", _outputContainer);
            }
            catch
            {
                // Ignore JS interop errors
            }
        }
        
        // Refocus input after command execution
        if (!_isExecuting && _inputElement.Context != null)
        {
            try
            {
                await _inputElement.FocusAsync();
            }
            catch
            {
                // Ignore focus errors
            }
        }
    }

    private string GetPrompt()
    {
        if (Terminal == null) return ">";
        
        return !string.IsNullOrEmpty(Terminal.Prompt) 
            ? Terminal.Prompt 
            : Terminal.Type switch
            {
                TerminalType.ReportServer => "rs>",
                TerminalType.JavaScript => "js>",
                _ => ">"
            };
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (Terminal == null || _isExecuting) return;

        switch (e.Key)
        {
            case "Enter":
                await ExecuteCommand();
                break;
                
            case "ArrowUp":
                NavigateHistory(1);
                break;
                
            case "ArrowDown":
                NavigateHistory(-1);
                break;
        }
    }

    private void NavigateHistory(int direction)
    {
        if (Terminal == null)
            return;

        _currentCommand = TerminalManager.NavigateHistory(Terminal.Id, direction, _currentCommand);
    }

    private async Task ExecuteCommand()
    {
        if (string.IsNullOrWhiteSpace(_currentCommand) || Terminal == null || _isExecuting)
            return;

        _isExecuting = true;
        var command = _currentCommand.Trim();
        _currentCommand = string.Empty;
        TerminalManager.ResetHistoryNavigation(Terminal.Id);

        try
        {
            var entry = await TerminalManager.ExecuteAsync(Terminal.Id, command, CancellationToken.None);
            if (entry != null)
                await OnCommandExecuted.InvokeAsync(entry);
        }
        catch (Exception ex)
        {
            var errorEntry = new CommandEntry
            {
                Command = command,
                Output = string.Empty,
                Error = ex.Message,
                IsSuccess = false
            };
            Terminal.CommandHistory.Add(errorEntry);
            await OnCommandExecuted.InvokeAsync(errorEntry);
        }
        finally
        {
            _isExecuting = false;
            StateHasChanged(); // Trigger re-render which will refocus input
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}

