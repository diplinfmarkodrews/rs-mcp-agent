@inject NavigationManager Navigation
@inject ILogger<LoginModal> Logger
@inject IJSRuntime JSRuntime
@using Microsoft.Extensions.Logging
@using RsMcpServer.Identity.Services
@inject IAuthenticationService LegacyAuthService
@if (Show)
{
    <div class="modal-backdrop" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 1050; display: flex; justify-content: center; align-items: center;" @onclick="@CloseModal">
        <div class="modal-content" style="background-color: white; border-radius: 8px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); max-width: 600px; width: 95%; max-height: 90vh; overflow: hidden;" @onclick:stopPropagation="true">
            <div class="modal-header" style="padding: 1rem 1.5rem; border-bottom: 1px solid #dee2e6; display: flex; justify-content: space-between; align-items: center;">
                <h5 class="modal-title" style="margin: 0; font-size: 1.25rem; font-weight: 500;">Login to ReportServer</h5>
                <button type="button" class="btn-close" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #6c757d; padding: 0; width: 1.5rem; height: 1.5rem;" @onclick="@CloseModal" aria-label="Close">×</button>
            </div>
            <div class="modal-body" style="padding: 0; height: 500px; position: relative;">
                @if (hasError)
                {
                    <div class="text-center" style="padding: 2rem;">
                        <div style="color: #dc3545; font-size: 48px; margin-bottom: 20px;">⚠</div>
                        <h4 style="color: #dc3545; margin-bottom: 1rem;">Authentication Error</h4>
                        <p style="margin-bottom: 1rem;">@errorMessage</p>
                        <div style="margin-top: 1.5rem;">
                            <button class="btn-default" @onclick="@RetryAuthentication" style="margin-right: 1rem;">
                                <i class="fas fa-redo me-2"></i>
                                Try Again
                            </button>
                        </div>
                    </div>
                }
                else if (UseLegacyAuth)
                {
                    <!-- Legacy Login Form -->
                    <div class="legacy-login-container">
                        <div class="login-header">
                            <h3>Welcome Back</h3>
                            <p>Sign in to your ReportServer account</p>
                        </div>
                        
                        <form @onsubmit="@HandleLegacyLogin" @onsubmit:preventDefault="true" class="login-form">
                            <div class="form-group">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" 
                                       class="form-input" 
                                       id="username" 
                                       @bind="username" 
                                       placeholder="Enter your username" 
                                       required 
                                       autocomplete="username" />
                            </div>
                            
                            <div class="form-group">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" 
                                       class="form-input" 
                                       id="password" 
                                       @bind="password" 
                                       placeholder="Enter your password" 
                                       required 
                                       autocomplete="current-password" />
                            </div>
                            
                            <div class="form-group checkbox-group">
                                <label class="checkbox-wrapper">
                                    <input type="checkbox" @bind="rememberMe" class="checkbox-input" />
                                    <span class="checkbox-custom"></span>
                                    <span class="checkbox-label">Remember me for 30 days</span>
                                </label>
                            </div>
                            
                            <div class="form-group">
                                <button type="submit" class="btn-login" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <div class="btn-spinner"></div>
                                        <span>Signing in...</span>
                                    }
                                    else
                                    {
                                        <span>Sign In</span>
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M5 12h14"></path>
                                            <path d="M12 5l7 7-7 7"></path>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>
                }
                else if (showIframe)
                {
                    <!-- Keycloak Authentication Iframe -->
                    <iframe @ref="authIframe" 
                            src="@authUrl" 
                            style="width: 100%; height: 100%; border: none;"
                            @onload="OnIframeLoad">
                    </iframe>
                    @if (isLoading)
                    {
                        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(255, 255, 255, 0.8); display: flex; justify-content: center; align-items: center;">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading authentication...</span>
                                </div>
                                <div class="mt-2">Loading authentication...</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center" style="padding: 2rem;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Initializing authentication...</span>
                        </div>
                        <div class="mt-2">Initializing authentication...</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public EventCallback OnLoginSuccess { get; set; }
    [Parameter] public bool UseLegacyAuth { get; set; } = true; // Option to choose between legacy and Keycloak

    private bool isLoading = false;
    private bool showIframe = false;
    private bool hasError = false;
    private string errorMessage = "";
    private string authUrl = "";
    private ElementReference authIframe;

    // Legacy login form fields
    private string username = "";
    private string password = "";
    private bool rememberMe = false;

    private async Task CloseModal()
    {
        Show = false;
        showIframe = false;
        isLoading = false;
        hasError = false;
        errorMessage = "";
        await ShowChanged.InvokeAsync(Show);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reset state and auto-start authentication when modal is shown
        if (Show)
        {
            isLoading = false;
            showIframe = false;
            hasError = false;
            errorMessage = "";
            
            // Start appropriate authentication based on UseLegacyAuth setting
            if (!UseLegacyAuth)
            {
                // Automatically start the Keycloak authentication process
                await LoadKeycloakInIframe();
            }
            // For legacy auth, just show the form (no auto-start needed)
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Show)
        {
            // Add JavaScript to listen for authentication completion
            await JSRuntime.InvokeVoidAsync("setupAuthenticationListener", DotNetObjectReference.Create(this));
        }
    }

    private async Task LoadKeycloakInIframe()
    {
        try
        {
            hasError = false;
            errorMessage = "";
            isLoading = true;
            StateHasChanged();
            
            // Use the existing auth/challenge endpoint from KeycloakAuthenticationExtensions
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            var returnUrl = Uri.EscapeDataString($"{baseUrl}/auth/popup-auth-success");
            authUrl = $"{baseUrl}/auth/challenge?returnUrl={returnUrl}";
            
            Logger.LogInformation("Loading authentication URL: {AuthUrl}", authUrl);
            
            showIframe = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Keycloak in iframe");
            ShowError("Failed to initialize authentication. Please check if the authentication service is available and try again.");
        }
    }

    private async Task RetryAuthentication()
    {
        // Clear any existing error state        
        hasError = false;
        errorMessage = "";
        StateHasChanged();

        // Reload the appropriate authentication type
        if (UseLegacyAuth)
        {
            // For legacy auth, just clear the form errors (form is already shown)
            return;
        }
        else
        {
            // Reload Keycloak authentication
            await LoadKeycloakInIframe();
        }
    }

    private async Task HandleLegacyLogin()
    {

        // This method will handle the legacy login form submission
        isLoading = true;
        StateHasChanged();

        try
        {
            // Placeholder for legacy authentication logic
            var tkS = new CancellationTokenSource();
            var authResult = await LegacyAuthService.AuthenticateAsync(username, password, tkS.Token);
            if (authResult.Success)
            {
                Logger.LogInformation("Legacy authentication successful for user: {Username}", username);
                Logger.LogDebug("Token Details: {Token}", authResult.Token);
                await OnLoginSuccess.InvokeAsync();
                await CloseModal();
            }
            else
            {
                Logger.LogWarning("Legacy authentication failed for user: {Username}. Reason: {Reason}", username, authResult.ErrorMessage);
                ShowError("Invalid username or password. Please try again.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during legacy authentication");
            ShowError("Authentication failed. Please try again.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowError(string message)
    {
        hasError = true;
        errorMessage = message;
        isLoading = false;
        showIframe = false;
        StateHasChanged();
    }

    private async Task OnIframeLoad()
    {
        isLoading = false;
        StateHasChanged();
        
        // Ensure authentication listener is set up
        await JSRuntime.InvokeVoidAsync("setupAuthenticationListener", DotNetObjectReference.Create(this));
        
        // Start monitoring for authentication completion
        await JSRuntime.InvokeVoidAsync("monitorAuthenticationIframe", authIframe);
    }

    [JSInvokable]
    public async Task OnAuthenticationSuccess()
    {
        Logger.LogInformation("Authentication successful");
        await OnLoginSuccess.InvokeAsync();
        await CloseModal();
    }

    [JSInvokable]
    public async Task OnAuthenticationError(string error)
    {
        Logger.LogError("Authentication error: {Error}", error);
        
        // Map common error messages to user-friendly ones
        string userMessage = error.ToLowerInvariant() switch
        {
            var msg when msg.Contains("invalid_request") => "The authentication request was invalid. Please check your configuration.",
            var msg when msg.Contains("access_denied") => "Access was denied. Please check your credentials and permissions.",
            var msg when msg.Contains("server_error") => "The authentication server encountered an error. Please try again later.",
            var msg when msg.Contains("temporarily_unavailable") => "The authentication service is temporarily unavailable. Please try again in a few moments.",
            var msg when msg.Contains("connection") || msg.Contains("network") => "Unable to connect to the authentication service. Please check your network connection.",
            _ => $"Authentication failed: {error}"
        };
        
        ShowError(userMessage);
    }

    [JSInvokable]
    public async Task OnConnectionError()
    {
        Logger.LogError("Connection error during authentication");
        ShowError("Unable to connect to the authentication service. Please check if Keycloak is running and accessible.");
    }

    [JSInvokable]
    public async Task OnAuthenticationRetry()
    {
        Logger.LogInformation("User requested authentication retry");
        await RetryAuthentication();
    }

    [JSInvokable]
    public async Task OnAuthenticationClose()
    {
        Logger.LogInformation("User requested to close authentication");
        await CloseModal();
    }
}
